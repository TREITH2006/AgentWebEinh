# AgentWebEinh backend configuration.
#
# Copy to `backend/.env`. Every variable is optional: the defaults below run with
# no configuration at all, and the process reads this file automatically.
#
# The env prefix is `AWE_`, so a setting named `port` is `AWE_PORT`.
# `python -m app.cli config` prints the fully resolved values.

# ------------------------------------------------------------------ server ----
AWE_APP_NAME=AgentWebEinh API
# development | production | test
AWE_ENVIRONMENT=development
AWE_HOST=127.0.0.1
AWE_PORT=8000
# Absolute, externally reachable base URL. Frame URLs are absolute, so this must
# match what a browser can actually reach — behind a proxy, set it to that origin.
AWE_PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- database ----
# Must stay inside the repository; any other path is rejected at startup.
# Relative paths resolve against the project root.
AWE_DATABASE_FILE=data/tasks.db

# ------------------------------------------------------------------ workers ---
AWE_MAX_CONCURRENT_TASKS=2
AWE_TASK_TIMEOUT_SECONDS=1800
# Budget for ONE model call inside the agent loop. qwen3-vl:8b on CPU needs well
# over two minutes per action, so this must stay above the model's real latency.
# Measured on this machine: ~10s to >300s for the same call, because the length
# of the model's `thinking` block is unpredictable. A step that does time out is
# retried and counted as a fruitless step, not a task failure.
AWE_STEP_TIMEOUT_SECONDS=420
AWE_MAX_ORCHESTRATOR_STEPS=30
# Only one task drives the browser at a time. This bounds how long a second task
# waits for it before failing with an honest "browser busy" error.
AWE_BROWSER_SESSION_WAIT_SECONDS=600
# How long GET /api/status may reuse the previous integration probe, seconds.
# One of those probes spawns the OpenClaw CLI, which needs several seconds to
# start on Windows. Without a cache every page load paid that cost, overran the
# frontend's probe deadline, and reported a healthy backend as unreachable.
AWE_STATUS_CACHE_SECONDS=15
# How long GET /api/status may reuse the previous integration probe. The OpenClaw
# probe is a subprocess that needs seconds to start on Windows; without a cache
# every page load paid that cost and the UI reported a healthy backend as
# unreachable. 0 disables caching.
AWE_STATUS_CACHE_SECONDS=15
# Per-connection event queue depth before the oldest frame is shed.
AWE_STREAM_QUEUE_SIZE=256
# false would leave a client with no data until the next event.
AWE_SEND_SNAPSHOT_ON_CONNECT=true

# ------------------------------------------------------------------- limits ---
AWE_PROMPT_MIN_LENGTH=1
AWE_PROMPT_MAX_LENGTH=2000
AWE_HISTORY_DEFAULT_LIMIT=25
AWE_HISTORY_MAX_LIMIT=200

# ------------------------------------------------------------------- Ollama ---
# Health is a GET /api/tags only; nothing here loads weights or downloads a model.
AWE_OLLAMA_ENABLED=true
AWE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AWE_OLLAMA_MODEL=qwen3-vl:8b
AWE_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
AWE_OLLAMA_HEALTH_TIMEOUT_SECONDS=4
AWE_OLLAMA_TIMEOUT_SECONDS=480
# Must exceed the num_predict floor: Ollama silently drops the oldest messages
# when prompt plus predicted tokens exceed the context window.
AWE_OLLAMA_NUM_CTX=16384
AWE_OLLAMA_TEMPERATURE=0.1
AWE_OLLAMA_KEEP_ALIVE=10m
# Floor for every num_predict budget. Reasoning models (qwen3-*) spend this budget
# on a `thinking` block before answering, so a small cap returns an empty completion
# with done_reason=length. qwen3-vl:8b needs ~3k tokens, measured; raise it for
# models that deliberate at length.
AWE_OLLAMA_NUM_PREDICT_FLOOR=8192
# Every caller wants one direct JSON answer, so thinking is off by default.
AWE_OLLAMA_THINK=false

# ------------------------------------------------------------------ browser ---
# Native Playwright. `browser_use` is not installed and is not supported.
AWE_BROWSER_ENABLED=true
AWE_BROWSER_ENGINE=native
AWE_BROWSER_HEADLESS=true
AWE_BROWSER_VIEWPORT_WIDTH=1440
AWE_BROWSER_VIEWPORT_HEIGHT=900
AWE_BROWSER_NAVIGATION_TIMEOUT_MS=30000
AWE_BROWSER_SLOW_MO_MS=0
AWE_BROWSER_FRAME_INTERVAL_MS=1000
AWE_BROWSER_FRAME_QUALITY=70
# A larger frame is rejected rather than truncated: a corrupt JPEG would make
# the interface report that the stream died.
AWE_BROWSER_MAX_SCREENSHOT_BYTES=8000000
# Override only to match a site that needs a specific agent string.
# AWE_BROWSER_USER_AGENT=
# Screenshot writes land here; must stay inside the repository.
# AWE_SCREENSHOTS_DIR=data/screenshots

# ----------------------------------------------------------------- OpenClaw ---
# Optional. When unreachable the task continues on the native engine and /health
# still returns 200 with this component reported as down.
#
# Each task runs in its own session, `agent:main:<prefix>-<task_id>`, so a live
# personal session is never taken over. Nothing is ever delivered to a channel.
AWE_OPENCLAW_ENABLED=true
AWE_OPENCLAW_CLI=openclaw
AWE_OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
AWE_OPENCLAW_AGENT_ID=main
AWE_OPENCLAW_SESSION_PREFIX=awe
# Covers the whole `openclaw health --json` process, not just the gateway probe:
# the CLI needs several seconds to start on Windows, so a tight budget reports a
# perfectly healthy gateway as down.
AWE_OPENCLAW_HEALTH_TIMEOUT_MS=20000
AWE_OPENCLAW_AGENT_TIMEOUT_SECONDS=180
# true = OpenClaw answers instead of the browser loop (research-style tasks).
# false = the browser runs first and OpenClaw only supplements it.
AWE_OPENCLAW_ORCHESTRATES=false

# ----------------------------------------------------------------- TinyFish ---
# Optional and off by default. Uses the `tinyfish` CLI, not a raw HTTP API.
AWE_TINYFISH_ENABLED=false
AWE_TINYFISH_CLI=tinyfish
AWE_TINYFISH_TIMEOUT_SECONDS=60
AWE_TINYFISH_MAX_RESULTS=5

# --------------------------------------------------------------------- logs ---
AWE_LOG_LEVEL=INFO
# true = one JSON object per line, for a log shipper.
AWE_LOG_JSON=false

# ---------------------------------------------------------------------- CORS ---
# JSON list, e.g. AWE_CORS_ORIGINS=["http://localhost:3000"]
# Only needed when the browser calls the API directly; the Next.js proxy does not
# need it.
AWE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Escape hatch for wildcard dev hosts; prefer an explicit list in production.
# AWE_ALLOW_ORIGIN_REGEX=