# =============================================================================
# AgentWebEinh frontend — environment
# Copy to `.env.local` and adjust. Every variable is optional: with none of them
# set, the app runs in demo mode against deterministic fixtures.
# =============================================================================

# ---------------------------------------------------------------- data source --
# auto  -> probe the backend; fall back to demo if it is unreachable
# live  -> always call the backend; surface errors instead of falling back
# demo  -> never touch the network
NEXT_PUBLIC_API_MODE=auto

# -------------------------------------------------------------------- backend --
# Leave empty to route every call through the Next.js rewrite in
# next.config.ts. This is the recommended setup: it avoids CORS entirely.
# Set an absolute URL (e.g. http://127.0.0.1:8001) only if the backend sends
# permissive CORS headers.
NEXT_PUBLIC_API_BASE_URL=

# Origin the rewrite forwards to. Read only in next.config.ts, which runs on the
# server, so despite the NEXT_PUBLIC_ prefix it is not inlined into the client
# bundle. No component or lib/ module reads it.
#
# 8001, not 8000: 8000 is the backend's documented default but is commonly held by
# another local service, and this project runs on 8001.
NEXT_PUBLIC_API_PROXY_TARGET=http://127.0.0.1:8001

# WebSocket base URL. Leave empty to proxy the stream through this app on
# /ws/backend. Set it only if the stream lives on a different host than REST, in
# which case the endpoint path is appended unchanged.
NEXT_PUBLIC_WS_URL=

# ------------------------------------------------------------------ behaviour --
# Hard timeout for REST calls, ms.
NEXT_PUBLIC_API_TIMEOUT_MS=20000
# Timeout for the live-vs-demo availability probe, ms.
# Must exceed the backend's worst-case /api/status, which runs real integration
# probes (one spawns a CLI needing several seconds to start on Windows). A budget
# below that reports a healthy backend as unreachable.
NEXT_PUBLIC_API_PROBE_TIMEOUT_MS=15000
# Poll interval used when the WebSocket stream is unavailable, ms.
NEXT_PUBLIC_POLL_INTERVAL_MS=2500
# Character budget for the task composer.
NEXT_PUBLIC_MAX_PROMPT_LENGTH=2000
# Page size for task history.
NEXT_PUBLIC_HISTORY_PAGE_SIZE=25